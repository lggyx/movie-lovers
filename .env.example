# Copy this file to .env (or export the variables) before running the app.
# Get a free API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Optional: random string used to sign session cookies.
# If unset, the app generates one automatically and stores it in data/secret.key.
AUTH_SECRET=

# Optional: set TMDB_MOCK=1 to run without a real key (serves bundled fixture data).
# Intended for offline demos, screenshots and automated tests — not for real usage.
TMDB_MOCK=0
